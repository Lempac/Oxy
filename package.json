{
    "private": true,
    "type": "module",
    "packageManager": "pnpm@11.18.0",
    "scripts": {
        "dev": "vite",
        "build:hooks": "esbuild src/hooks/*.ts --outdir=pb_hooks --out-extension:.js=.pb.js --format=cjs",
        "watch:hooks": "esbuild src/hooks/*.ts --outdir=pb_hooks --out-extension:.js=.pb.js --format=cjs --watch",
        "build": "pnpm run build:hooks && vite build",
        "yjs": "y-websocket-server",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@vitejs/plugin-vue": "6.0.8",
        "@vue/server-renderer": "^3.5.41",
        "@vue/test-utils": "^2.4.11",
        "autoprefixer": "^10.5.4",
        "daisyui": "5.7.14",
        "eslint": "^10.9.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-vue": "^10.10.0",
        "globals": "17.8.0",
        "jiti": "^2.7.0",
        "jsdom": "^29.1.1",
        "konva": "^10.3.1",
        "postcss": "8.5.25",
        "tailwindcss": "^4.3.3",
        "typescript": "6.0.3",
        "typescript-eslint": "8.64.0",
        "vite": "^8.2.2",
        "vitest": "^4.1.11",
        "vue": "^3.5.41",
        "vue-konva": "^3.4.0",
        "vue-tsc": "^3.3.11",
        "y-protocols": "^1.0.7",
        "y-websocket": "^2.1.0",
        "yjs": "^13.6.32"
    },
    "dependencies": {
        "@tailwindcss/vite": "^4.3.3",
        "bad-words": "^4.1.5",
        "livekit-client": "^2.22.0",
        "pocketbase": "^0.28.0",
        "ts-node": "^10.9.2",
        "vue-icons-plus": "^0.1.9",
        "vue-router": "^4.6.4"
    }
}
