{
    "name": "oxy",
    "version": "0.1.0",
    "description": "Real-time communication and whiteboard app",
    "homepage": "https://github.com/lempac/Oxy",
    "author": {
        "name": "Oxy Team",
        "email": "dev@oxy.app"
    },
    "private": true,
    "type": "module",
    "main": "electron-dist/main.cjs",
    "packageManager": "pnpm@11.18.0",
    "scripts": {
        "dev": "vite",
        "build:hooks": "esbuild src/hooks/invites.ts src/hooks/livekit_token.ts src/hooks/profile.ts src/hooks/servers.ts src/hooks/whiteboards.ts --outdir=pb_hooks --out-extension:.js=.pb.js",
        "watch:hooks": "esbuild src/hooks/invites.ts src/hooks/livekit_token.ts src/hooks/profile.ts src/hooks/servers.ts src/hooks/whiteboards.ts --outdir=pb_hooks --out-extension:.js=.pb.js --watch=forever",
        "build:electron": "esbuild electron/main.ts electron/preload.ts --outdir=electron-dist --out-extension:.js=.cjs --format=cjs --platform=node",
        "electron:dev": "pnpm build && pnpm build:electron && electron .",
        "electron:build": "pnpm build && pnpm build:electron && electron-builder",
        "cap:sync": "pnpm build && npx cap sync",
        "cap:open:ios": "npx cap open ios",
        "cap:open:android": "npx cap open android",
        "build": "pnpm run build:hooks && vite build",
        "typecheck": "vue-tsc --noEmit",
        "yjs": "y-websocket-server",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "devDependencies": {
        "@capacitor/android": "^8.5.0",
        "@capacitor/cli": "^8.5.0",
        "@capacitor/ios": "^8.5.0",
        "@eslint/js": "^10.0.1",
        "@types/node": "^26.3.0",
        "@vitejs/plugin-vue": "6.0.8",
        "@vue/runtime-core": "^3.5.41",
        "@vue/runtime-dom": "^3.5.41",
        "@vue/server-renderer": "^3.5.41",
        "@vue/test-utils": "^2.4.11",
        "autoprefixer": "^10.5.4",
        "daisyui": "5.7.22",
        "electron": "^44.0.0",
        "electron-builder": "^26.15.3",
        "eslint": "^10.9.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-vue": "^10.10.0",
        "globals": "17.11.0",
        "jiti": "^2.7.0",
        "jsdom": "^30.0.1",
        "konva": "^10.3.1",
        "postcss": "8.5.26",
        "tailwindcss": "^4.3.3",
        "typescript": "5.7.3",
        "typescript-eslint": "8.68.0",
        "vite": "^8.2.2",
        "vitest": "^4.1.11",
        "vue": "^3.5.41",
        "vue-konva": "^3.4.0",
        "vue-tsc": "^3.3.11",
        "y-protocols": "^1.0.7",
        "y-websocket": "^3.1.0",
        "yjs": "^13.6.32"
    },
    "dependencies": {
        "@capacitor/core": "^8.5.0",
        "@tailwindcss/vite": "^4.3.3",
        "bad-words": "^4.1.5",
        "livekit-client": "^2.22.0",
        "pocketbase": "^0.28.0",
        "ts-node": "^10.9.2",
        "vue-icons-plus": "^0.1.9",
        "vue-router": "^5.2.0"
    }
}
