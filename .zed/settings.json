{
"languages": {
    "PHP": {
        "format_on_save": "on",
        "formatter": {
            "external": {
                "command": "./vendor/bin/pint",
                "arguments": ["{buffer_path}"]
            }
        }
    }
},
"lsp": {
    "tailwindcss-language-server": {
      "settings": {
        "includeLanguages": {
          "php": "html",
          "blade": "html"
        },
        "experimental": {
          "classRegex": [
            "class=\"([^\"]*)\"",
            "class='([^']*)'",
            "class=\\\"([^\\\"]*)\\\"",
            "@class\\(\\[([^\\]]*)\\]\\)"
          ]
        }
      }
    }
  }
}
